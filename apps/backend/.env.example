# PostgreSQL (desarrollo local)
# Sustituye usuario, contraseña y host por los de tu instalación local.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/translog?schema=public"

# Usuario supervisor inicial (seed idempotente)
SUPERVISOR_EMAIL="supervisor@translog.local"
SUPERVISOR_PASSWORD="Supervisor123!"

# JWT (autenticación)
JWT_SECRET="cambia-esto-por-un-secreto-seguro-en-desarrollo"
JWT_EXPIRES_IN="1h"

# CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:4200
